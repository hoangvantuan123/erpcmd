{
  "name": "erpsyn-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "ERPSYN desktop app with a Go backend and embedded React interface",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "dev:web": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "build:web": "vite build --config vite.config.js",
    "build:desktop": "npm run build:web && go build -ldflags \"-H windowsgui -s -w\" -o ERPSYN-Desktop.exe ./cmd/desktop"
  },
  "devDependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.485.0",
    "marked": "^4.3.0",
    "postcss": "^8.4.49",
    "postcss-nested": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-responsive-carousel": "^3.2.23",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.3.1"
  }
}
